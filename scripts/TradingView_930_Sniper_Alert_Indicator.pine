//@version=6
indicator("ICT 9:30 Sniper — MNQ Indicator (Alert Edition v2)", overlay=true)

// =============================================================================
// 1. INPUTS & PROP FIRM SIZING
// =============================================================================
tz = "America/New_York"

grp_entry = "Execution Mode"
entry_mode = input.string("50% Wick Limit (Sealed)", "Entry Mode", options=["50% Wick Limit (Sealed)", "Direct Market at Close", "50/50 Hybrid"], group=grp_entry, tooltip="Sealed strategy uses 50% Wick Limit for maximum R:R. Direct Market enters immediately on bar close so you never miss runners.")

grp_vwap = "Anchored VWAP & Band Parameters"
vwap_mult   = input.float(2.0,  "Band Deviation Multiplier (σ)", minval=0.5, maxval=4.0, step=0.1, group=grp_vwap)
min_band_pt = input.float(15.0, "Min Band Distance from VWAP (pts)", minval=5.0, step=1.0, group=grp_vwap, tooltip="At 9:35, if bands are compressed <15 pts from VWAP, trade is skipped to avoid chop.")

grp_risk = "Risk & Target Parameters (Sealed Rules)"
wick_pct    = input.float(0.35, "Min Rejection Wick Ratio (35%)", minval=0.1, maxval=0.9, step=0.05, group=grp_risk)
min_crange  = input.float(6.0,  "Min Candle Range (pts)", minval=2.0, step=1.0, group=grp_risk)
stop_buffer = input.float(1.5,  "Stop Loss Buffer beyond Extreme (pts)", minval=0.5, step=0.5, group=grp_risk)
min_stop    = input.float(5.0,  "Min Stop Distance (pts)", minval=1.0, step=1.0, group=grp_risk)
max_stop    = input.float(60.0, "Max Stop Distance (pts)", minval=10.0, step=5.0, group=grp_risk)
min_rr      = input.float(1.5,  "Min R:R to VWAP (TP1)", minval=0.5, step=0.1, group=grp_risk)

grp_time = "Session Window (NY Time)"
in_window = not na(time(timeframe.period, "0930-1130", tz))

// =============================================================================
// 2. SESSION ANCHORED VWAP (Daily 09:30 AM Anchor)
// =============================================================================
var float cum_vol  = na
var float cum_pv   = na
var float cum_pv2  = na
var float vwap_val = na
var float upper_b  = na
var float lower_b  = na

is_930 = not na(time(timeframe.period, "0930-0931", tz))
tp_bar = (high + low + close) / 3.0

if is_930 and (na(cum_vol) or timeframe.change("D"))
    cum_vol  := volume
    cum_pv   := tp_bar * volume
    cum_pv2  := tp_bar * tp_bar * volume
    vwap_val := tp_bar
    upper_b  := tp_bar
    lower_b  := tp_bar
else if not na(cum_vol)
    cum_vol  += volume
    cum_pv   += tp_bar * volume
    cum_pv2  += tp_bar * tp_bar * volume
    vwap_val := cum_pv / cum_vol
    variance  = math.max(0.0, cum_pv2 / cum_vol - vwap_val * vwap_val)
    stdev     = math.sqrt(variance)
    upper_b  := vwap_val + vwap_mult * stdev
    lower_b  := vwap_val - vwap_mult * stdev

// Plot bands
p_vwap  = plot(vwap_val, "Daily 9:30 VWAP (TP1)", color=color.new(color.orange, 10), linewidth=2)
p_upper = plot(upper_b,  "Upper Band (+2.0σ)",   color=color.new(color.red, 30),    linewidth=1)
p_lower = plot(lower_b,  "Lower Band (-2.0σ)",   color=color.new(color.green, 30),  linewidth=1)
fill(p_upper, p_lower, color=color.new(color.blue, 96), title="VWAP Band Fill")

// =============================================================================
// 3. EXECUTION LOGIC (LONG & SHORT)
// =============================================================================
var bool traded_today = false
if timeframe.change("D")
    traded_today := false

crange    = high - low
up_wick   = high - math.max(open, close)
down_wick = math.min(open, close) - low

// A. LIVE INTRA-BAR TOUCH / EARLY WARNINGS
live_touch_lower = in_window and not traded_today and not na(lower_b) and (low <= lower_b) and ((vwap_val - lower_b) >= min_band_pt)
live_touch_upper = in_window and not traded_today and not na(upper_b) and (high >= upper_b) and ((upper_b - vwap_val) >= min_band_pt)

// B. BAR-CLOSE QUALIFIED SETUPS
qual_long  = in_window and not traded_today and not na(lower_b) and 
             ((vwap_val - lower_b) >= min_band_pt) and (low <= lower_b) and 
             (crange >= min_crange) and (down_wick >= crange * wick_pct) and (close > open)

qual_short = in_window and not traded_today and not na(upper_b) and 
             ((upper_b - vwap_val) >= min_band_pt) and (high >= upper_b) and 
             (crange >= min_crange) and (up_wick >= crange * wick_pct) and (close < open)

// Entry Calculation according to selected mode
var float long_entry  = na
var float long_stop   = na
var float long_tp1    = na
var float long_tp2    = na

var float short_entry = na
var float short_stop  = na
var float short_tp1   = na
var float short_tp2   = na

var bool sig_long  = false
var bool sig_short = false

sig_long  := false
sig_short := false

if qual_long
    long_entry := entry_mode == "Direct Market at Close" ? close : (low + 0.50 * down_wick)
    long_stop  := low - stop_buffer
    long_risk   = long_entry - long_stop
    long_tp1   := vwap_val  // SEALED RULE: TP1 IS ANCHORED VWAP
    long_tp2   := upper_b   // SEALED RULE: TP2 IS OPPOSITE 2.0σ BAND
    
    // Validate filters
    if long_risk >= min_stop and long_risk <= max_stop and (long_tp1 - long_entry) >= long_risk * min_rr
        sig_long := true
        traded_today := true

if qual_short
    short_entry := entry_mode == "Direct Market at Close" ? close : (high - 0.50 * up_wick)
    short_stop  := high + stop_buffer
    short_risk   = short_stop - short_entry
    short_tp1   := vwap_val // SEALED RULE: TP1 IS ANCHORED VWAP
    short_tp2   := lower_b  // SEALED RULE: TP2 IS OPPOSITE 2.0σ BAND

    // Validate filters
    if short_risk >= min_stop and short_risk <= max_stop and (short_entry - short_tp1) >= short_risk * min_rr
        sig_short := true
        traded_today := true

// =============================================================================
// 4. ON-CHART VISUALS
// =============================================================================
var line l_en = na
var line l_sl = na
var line l_tp1 = na
var line l_tp2 = na

if sig_long
    line.delete(l_en)
    line.delete(l_sl)
    line.delete(l_tp1)
    line.delete(l_tp2)

    l_en  := line.new(bar_index, long_entry, bar_index + 16, long_entry, color=color.aqua, width=2, style=line.style_dashed)
    l_sl  := line.new(bar_index, long_stop,  bar_index + 16, long_stop,  color=color.red,  width=2)
    l_tp1 := line.new(bar_index, long_tp1,   bar_index + 16, long_tp1,   color=color.orange, width=2)
    l_tp2 := line.new(bar_index, long_tp2,   bar_index + 16, long_tp2,   color=color.green,  width=2, style=line.style_dotted)

    label.new(bar_index + 2, long_entry, (entry_mode == "Direct Market at Close" ? "BUY MKT: " : "BUY LIMIT: ") + str.tostring(long_entry, "#.25"), color=color.aqua, textcolor=color.black, style=label.style_label_right, size=size.small)
    label.new(bar_index + 2, long_stop,  "STOP: " + str.tostring(long_stop, "#.25") + " (-" + str.tostring(long_entry - long_stop, "#.1") + " pts)", color=color.red,  textcolor=color.white, style=label.style_label_right, size=size.small)
    label.new(bar_index + 2, long_tp1,   "TP1 (VWAP Mean): " + str.tostring(long_tp1, "#.25"), color=color.orange, textcolor=color.white, style=label.style_label_right, size=size.small)
    label.new(bar_index + 2, long_tp2,   "TP2 (Opposite Band): " + str.tostring(long_tp2, "#.25"), color=color.green, textcolor=color.white, style=label.style_label_right, size=size.small)

if sig_short
    line.delete(l_en)
    line.delete(l_sl)
    line.delete(l_tp1)
    line.delete(l_tp2)

    l_en  := line.new(bar_index, short_entry, bar_index + 16, short_entry, color=color.aqua, width=2, style=line.style_dashed)
    l_sl  := line.new(bar_index, short_stop,  bar_index + 16, short_stop,  color=color.red,  width=2)
    l_tp1 := line.new(bar_index, short_tp1,   bar_index + 16, short_tp1,   color=color.orange, width=2)
    l_tp2 := line.new(bar_index, short_tp2,   bar_index + 16, short_tp2,   color=color.green,  width=2, style=line.style_dotted)

    label.new(bar_index + 2, short_entry, (entry_mode == "Direct Market at Close" ? "SELL MKT: " : "SELL LIMIT: ") + str.tostring(short_entry, "#.25"), color=color.aqua, textcolor=color.black, style=label.style_label_right, size=size.small)
    label.new(bar_index + 2, short_stop,  "STOP: " + str.tostring(short_stop, "#.25") + " (-" + str.tostring(short_stop - short_entry, "#.1") + " pts)", color=color.red, textcolor=color.white, style=label.style_label_right, size=size.small)
    label.new(bar_index + 2, short_tp1,   "TP1 (VWAP Mean): " + str.tostring(short_tp1, "#.25"), color=color.orange, textcolor=color.white, style=label.style_label_right, size=size.small)
    label.new(bar_index + 2, short_tp2,   "TP2 (Opposite Band): " + str.tostring(short_tp2, "#.25"), color=color.green, textcolor=color.white, style=label.style_label_right, size=size.small)

plotshape(sig_long,  "NQ Long Signal",  shape.triangleup,   location.belowbar, color=color.green, size=size.normal, text="NQ BUY")
plotshape(sig_short, "NQ Short Signal", shape.triangledown, location.abovebar, color=color.red,   size=size.normal, text="NQ SELL")
barcolor(sig_long ? color.yellow : (sig_short ? color.fuchsia : na))

// Hidden plots for alert placeholders
plot(sig_long ? long_entry : (sig_short ? short_entry : na), "Entry Level", display=display.none)
plot(sig_long ? long_stop  : (sig_short ? short_stop  : na), "Stop Level",  display=display.none)
plot(sig_long ? long_tp1   : (sig_short ? short_tp1   : na), "TP1 Level",   display=display.none)
plot(sig_long ? long_tp2   : (sig_short ? short_tp2   : na), "TP2 Level",   display=display.none)

// =============================================================================
// 5. TRADINGVIEW ALERTS
// =============================================================================
alertcondition(live_touch_lower or live_touch_upper, 
     title="NQ Early Warning: Band Pierced (Live Touch)", 
     message="⚠️ NQ LIVE TOUCH WARNING!\nPrice just swept the 2.0σ VWAP Band!\nWatch for 5m candle wick rejection NOW.")

alertcondition(sig_long or sig_short, 
     title="NQ 9:30 Sniper: Signal Confirmed (Bar Close)", 
     message="🚀 NQ 9:30 SNIPER CONFIRMED!\nSetup closed with rejection wick.\nEntry: {{plot_0}}\nStop: {{plot_1}}\nTP1 (VWAP): {{plot_2}}\nTP2 (Opposite Band): {{plot_3}}")
