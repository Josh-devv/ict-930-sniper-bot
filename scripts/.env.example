# Tradovate Bot Credentials
# Copy this file, rename to .env, fill in your details
# NEVER share this file or push to GitHub

# Your Tradovate login
TRADOVATE_USER=your_email@example.com
TRADOVATE_PASS=your_password

# From Tradovate Developer Portal (app.tradovate.com/api)
TRADOVATE_APP_ID=Sample App
TRADOVATE_APP_VERSION=1.0
TRADOVATE_DEVICE_ID=your_unique_device_id
TRADOVATE_CID=your_cid_number
TRADOVATE_SECRET=your_secret_key

# IMPORTANT: Keep this as "false" until you are ready to go LIVE
# false = demo/paper trading account
# true  = real money live account
LIVE_MODE=false

