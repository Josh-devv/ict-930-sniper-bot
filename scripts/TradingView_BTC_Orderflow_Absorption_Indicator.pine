//@version=6
indicator("ICT BTC Orderflow CVD Absorption (Alert Edition)", overlay=true)

// ==========================================
// INPUTS & PARAMETERS
// ==========================================
grp_of   = "Orderflow & Volume Settings"
vol_mult = input.float(1.3, "Volume Climax Multiplier", step=0.1, group=grp_of)
wick_min = input.float(0.30, "Min Absorption Wick Ratio (30%)", step=0.05, group=grp_of)
lookback = input.int(20, "Local Liquidity Sweep Lookback", minval=5, group=grp_of)

grp_risk = "Risk & Targets"
atr_mult = input.float(1.0, "Stop Loss ATR Buffer", step=0.1, group=grp_risk)
rr_tp1   = input.float(1.5, "TP1 Target Multiplier", step=0.1, group=grp_risk)
rr_tp2   = input.float(3.0, "TP2 Target Multiplier", step=0.5, group=grp_risk)

grp_time = "Session Windows (UTC)"
enable_london = input.bool(true, "London Session (07:00 - 11:00 UTC)", group=grp_time)
enable_ny     = input.bool(true, "NY Session (13:00 - 18:00 UTC)", group=grp_time)

// ==========================================
// TIME WINDOWS
// ==========================================
in_london = not na(time(timeframe.period, "0700-1100", "UTC")) and enable_london
in_ny     = not na(time(timeframe.period, "1300-1800", "UTC")) and enable_ny
is_active_session = in_london or in_ny

// ==========================================
// CALCULATIONS
// ==========================================
vol_ma     = ta.sma(volume, 20)
vol_climax = volume >= (vol_ma * vol_mult)

local_high = ta.highest(high, lookback)[1]
local_low  = ta.lowest(low, lookback)[1]

candle_range = math.max(0.5, high - low)
lower_wick   = math.min(open, close) - low
lower_wick_ratio = lower_wick / candle_range

atr = ta.atr(14)

// Signal Condition (Long-Only Absorption)
bull_absorption = is_active_session and vol_climax and (low <= local_low) and (lower_wick_ratio >= wick_min)

long_entry = low + 0.50 * lower_wick
long_stop  = low - atr_mult * atr
long_dist  = long_entry - long_stop
long_tp1   = long_entry + rr_tp1 * long_dist
long_tp2   = long_entry + rr_tp2 * long_dist

valid_signal = bull_absorption and (long_dist >= 40.0)

// ==========================================
// ON-CHART LINES & LABELS
// ==========================================
var line l_entry = na
var line l_stop  = na
var line l_tp1   = na
var line l_tp2   = na

if valid_signal
    line.delete(l_entry)
    line.delete(l_stop)
    line.delete(l_tp1)
    line.delete(l_tp2)

    l_entry := line.new(bar_index, long_entry, bar_index + 12, long_entry, color=color.aqua, width=2, style=line.style_dashed)
    l_stop  := line.new(bar_index, long_stop, bar_index + 12, long_stop, color=color.red, width=2)
    l_tp1   := line.new(bar_index, long_tp1, bar_index + 12, long_tp1, color=color.green, width=2)
    l_tp2   := line.new(bar_index, long_tp2, bar_index + 12, long_tp2, color=color.lime, width=2, style=line.style_dotted)

    label.new(bar_index + 2, long_entry, "BUY: " + str.tostring(long_entry, "#.##"), color=color.aqua, textcolor=color.black, style=label.style_label_right, size=size.small)
    label.new(bar_index + 2, long_stop, "STOP: " + str.tostring(long_stop, "#.##"), color=color.red, textcolor=color.white, style=label.style_label_right, size=size.small)
    label.new(bar_index + 2, long_tp1, "TP1: " + str.tostring(long_tp1, "#.##"), color=color.green, textcolor=color.white, style=label.style_label_right, size=size.small)
    label.new(bar_index + 2, long_tp2, "TP2: " + str.tostring(long_tp2, "#.##"), color=color.lime, textcolor=color.black, style=label.style_label_right, size=size.small)

// Visuals
plotshape(valid_signal, "Absorption Buy", shape.triangleup, location.belowbar, color=color.green, size=size.normal, text="BUY SIGNAL")
barcolor(valid_signal ? color.yellow : na)

// ==========================================
// NATIVE TRADINGVIEW ALERT TRIGGER (FREE PLAN COMPLIANT)
// ==========================================
alertcondition(valid_signal, title="BTC Absorption Buy Signal", message="BTC BUY SIGNAL!\nEntry: {{plot_0}}\nTimeframe: 5m\nCheck chart for Stop and TP levels.")
