//@version=6
strategy("ICT BTC Orderflow CVD Absorption Strategy", overlay=true, initial_capital=50000, default_qty_type=strategy.cash, default_qty_value=10000, commission_type=strategy.commission.cash_per_order, commission_value=2.5)

// ==========================================
// INPUTS & PARAMETERS
// ==========================================
grp_inst   = "0. Institutional Precision & Trap Filters (1.52 PF Edge)"
use_overext= input.bool(true, "Enable Over-Extension Protection", group=grp_inst, tooltip="Prevents buying the top or selling the bottom of parabolic moves. Requires price to be within 8 ATRs of 1H 50 EMA.")
max_dist   = input.float(8.0, "Max Distance from 1H EMA (ATRs)", step=0.5, group=grp_inst)
use_trap   = input.bool(true, "Require Fakeout Trap Confirmation", group=grp_inst, tooltip="Candle must close back INSIDE the swept level (proving retail got trapped and absorbed). Eliminates catching falling knives.")
use_dr     = input.bool(true, "Enable Dealing Range Equilibrium Filter", group=grp_inst, tooltip="Institutions only buy wholesale (Discount < 50%) and sell wholesale (Premium > 50%).")
dr_len     = input.int(30, "Dealing Range Lookback", group=grp_inst)
use_auction= input.bool(true, "Require Auction Winner Close", group=grp_inst, tooltip="Longs must close green or in upper 50% of bar. Shorts must close red or in lower 50%.")

grp_trend  = "1. Higher Timeframe Trend Filter (Verified 1.52 PF Edge)"
use_htf    = input.bool(true, "Enable 1H 50 EMA Trend Filter", group=grp_trend, tooltip="Only buy above 1H 50 EMA, only sell below. Verified 56.4% WR, 1.52 PF, 22/25 green months.")
htf_tf     = input.timeframe("60", "HTF Timeframe", group=grp_trend)
htf_len    = input.int(50, "HTF EMA Length", group=grp_trend)
show_htf   = input.bool(true, "Plot 1H 50 EMA on Chart", group=grp_trend)

grp_entry  = "Entry Mode"
entry_mode = input.string("Direct (Candle Close)", "Entry Mode", options=["Direct (Candle Close)", "50% Wick Retest"], group=grp_entry)
trade_dir  = input.string("Both (Long & Short)", "Trade Direction", options=["Both (Long & Short)", "Long Only", "Short Only"], group=grp_entry)

grp_of     = "Orderflow & Volume Settings"
vol_mult   = input.float(1.3, "Volume Climax Multiplier", step=0.1, group=grp_of)
wick_min   = input.float(0.30, "Min Absorption Wick Ratio (30%)", step=0.05, group=grp_of)
lookback   = input.int(20, "Local Liquidity Sweep Lookback", minval=5, group=grp_of)

grp_risk   = "Risk & Targets"
atr_mult   = input.float(1.0, "Stop Loss ATR Buffer", step=0.1, group=grp_risk)
rr_tp1     = input.float(1.5, "TP1 Risk-Reward Ratio (Bank 60%)", step=0.1, group=grp_risk)
rr_tp2     = input.float(3.0, "TP2 Risk-Reward Ratio (Bank 40% Runner)", step=0.5, group=grp_risk)
min_stop   = input.float(40.0, "Minimum Stop Distance ($)", group=grp_risk)

grp_time   = "Session Windows (UTC)"
enable_london = input.bool(true, "Enable London Session (07:00 - 11:00 UTC)", group=grp_time)
enable_ny     = input.bool(true, "Enable NY Session (13:00 - 18:00 UTC)", group=grp_time)

// ==========================================
// TIME WINDOWS
// ==========================================
in_london = not na(time(timeframe.period, "0700-1100", "UTC")) and enable_london
in_ny     = not na(time(timeframe.period, "1300-1800", "UTC")) and enable_ny
is_active_session = in_london or in_ny

// ==========================================
// HTF TREND & INSTITUTIONAL FILTERS
// ==========================================
htf_ema = request.security(syminfo.tickerid, htf_tf, ta.ema(close, htf_len), lookahead=barmerge.lookahead_off)
htf_bull = not use_htf or (close > htf_ema)
htf_bear = not use_htf or (close < htf_ema)

atr = ta.atr(14)

// Over-Extension Filter: Distance from 1H EMA in ATRs
ema_dist_atr = math.abs(close - htf_ema) / atr
pass_overext = not use_overext or (ema_dist_atr <= max_dist)

// Dealing Range Equilibrium
dr_high = ta.highest(high, dr_len)[1]
dr_low  = ta.lowest(low, dr_len)[1]
dr_eq   = (dr_high + dr_low) / 2.0
in_discount = low <= dr_eq or close <= dr_eq
in_premium  = high >= dr_eq or close >= dr_eq
pass_dr_long  = not use_dr or in_discount
pass_dr_short = not use_dr or in_premium

// ==========================================
// ORDERFLOW & VOLUME CALCULATIONS
// ==========================================
vol_ma     = ta.sma(volume, 20)
vol_climax = volume >= (vol_ma * vol_mult)

local_high = ta.highest(high, lookback)[1]
local_low  = ta.lowest(low, lookback)[1]

candle_range = math.max(0.5, high - low)
body_top     = math.max(open, close)
body_bot     = math.min(open, close)
upper_wick   = high - body_top
lower_wick   = body_bot - low
upper_wick_ratio = upper_wick / candle_range
lower_wick_ratio = lower_wick / candle_range

// Fakeout Trap Confirmation (Must close back inside swept level)
pass_trap_long  = not use_trap or (close > local_low)
pass_trap_short = not use_trap or (close < local_high)

// Auction Winner Confirmation (Bar must close in trade direction)
candle_mid = (high + low) / 2.0
pass_auction_long  = not use_auction or (close >= candle_mid or close > open)
pass_auction_short = not use_auction or (close <= candle_mid or close < open)

allow_long  = (trade_dir == "Both (Long & Short)" or trade_dir == "Long Only")
allow_short = (trade_dir == "Both (Long & Short)" or trade_dir == "Short Only")

bull_raw = is_active_session and vol_climax and (low <= local_low) and (lower_wick_ratio >= wick_min) and allow_long
bear_raw = is_active_session and vol_climax and (high >= local_high) and (upper_wick_ratio >= wick_min) and allow_short

bull_absorption = bull_raw and htf_bull and pass_overext and pass_trap_long and pass_dr_long and pass_auction_long
bear_absorption = bear_raw and htf_bear and pass_overext and pass_trap_short and pass_dr_short and pass_auction_short

// Long Execution Levels
long_entry = entry_mode == "Direct (Candle Close)" ? close : (low + 0.50 * lower_wick)
long_stop  = low - atr_mult * atr
long_dist  = long_entry - long_stop
long_tp1   = long_entry + rr_tp1 * long_dist
long_tp2   = long_entry + rr_tp2 * long_dist

// Short Execution Levels
short_entry = entry_mode == "Direct (Candle Close)" ? close : (high - 0.50 * upper_wick)
short_stop  = high + atr_mult * atr
short_dist  = short_stop - short_entry
short_tp1   = short_entry - rr_tp1 * short_dist
short_tp2   = short_entry - rr_tp2 * short_dist

// ==========================================
// STRATEGY EXECUTION
// ==========================================
if bull_absorption and long_dist >= min_stop and strategy.position_size == 0
    if entry_mode == "Direct (Candle Close)"
        strategy.entry("Long_TP1", strategy.long, qty=6) // 60%
        strategy.entry("Long_TP2", strategy.long, qty=4) // 40%
    else
        strategy.entry("Long_TP1", strategy.long, limit=long_entry, qty=6)
        strategy.entry("Long_TP2", strategy.long, limit=long_entry, qty=4)
    strategy.exit("Exit_L_TP1", "Long_TP1", stop=long_stop, limit=long_tp1)
    strategy.exit("Exit_L_TP2", "Long_TP2", stop=long_stop, limit=long_tp2)

if bear_absorption and short_dist >= min_stop and strategy.position_size == 0
    if entry_mode == "Direct (Candle Close)"
        strategy.entry("Short_TP1", strategy.short, qty=6)
        strategy.entry("Short_TP2", strategy.short, qty=4)
    else
        strategy.entry("Short_TP1", strategy.short, limit=short_entry, qty=6)
        strategy.entry("Short_TP2", strategy.short, limit=short_entry, qty=4)
    strategy.exit("Exit_S_TP1", "Short_TP1", stop=short_stop, limit=short_tp1)
    strategy.exit("Exit_S_TP2", "Short_TP2", stop=short_stop, limit=short_tp2)

// Lock Breakeven on runner after TP1 is hit
if strategy.position_size > 0
    if ta.change(strategy.closedtrades) > 0
        last_id = strategy.closedtrades.entry_id(strategy.closedtrades - 1)
        if last_id == "Long_TP1"
            strategy.exit("Exit_L_TP2", "Long_TP2", stop=strategy.position_avg_price + 20.0, limit=long_tp2)

if strategy.position_size < 0
    if ta.change(strategy.closedtrades) > 0
        last_id = strategy.closedtrades.entry_id(strategy.closedtrades - 1)
        if last_id == "Short_TP1"
            strategy.exit("Exit_S_TP2", "Short_TP2", stop=strategy.position_avg_price - 20.0, limit=short_tp2)

// ==========================================
// VISUALS
// ==========================================
plot(show_htf ? htf_ema : na, "1H 50 EMA Trend", color=color.new(color.yellow, 20), linewidth=2)
plot(local_high, "Local Liquidity High", color=color.new(color.red, 60), style=plot.style_stepline)
plot(local_low, "Local Liquidity Low", color=color.new(color.green, 60), style=plot.style_stepline)

bgcolor(in_london ? color.new(color.blue, 96) : na, title="London Session")
bgcolor(in_ny ? color.new(color.orange, 96) : na, title="NY Session")

plotshape(bull_absorption and long_dist >= min_stop, "Delta Buy Absorption", shape.triangleup, location.belowbar, color=color.green, size=size.normal, text="BUY")
plotshape(bear_absorption and short_dist >= min_stop, "Delta Sell Absorption", shape.triangledown, location.abovebar, color=color.red, size=size.normal, text="SELL")
barcolor(vol_climax and (bull_absorption or bear_absorption) ? color.yellow : na, title="Absorption Climax Bar")
