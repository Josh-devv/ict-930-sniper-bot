//@version=6
strategy("ICT BTC Orderflow CVD Absorption Sniper", overlay=true, initial_capital=50000, default_qty_type=strategy.cash, default_qty_value=10000, commission_type=strategy.commission.cash_per_order, commission_value=2.5)

// ==========================================
// INPUTS & PARAMETERS
// ==========================================
grp_of   = "Orderflow & Volume Settings"
vol_mult = input.float(1.3, "Volume Climax Multiplier", step=0.1, group=grp_of, tooltip="Volume must exceed this multiple of the 20-period SMA")
wick_min = input.float(0.30, "Min Absorption Wick Ratio (30%)", step=0.05, group=grp_of, tooltip="Wick must be >= 30% of total candle range")
lookback = input.int(20, "Local Liquidity Sweep Lookback", minval=5, group=grp_of, tooltip="Number of bars to determine previous local high/low")

grp_dir  = "Directional Bias"
long_only = input.bool(true, "Trade LONG-Only (Recommended: 98% WR)", group=grp_dir, tooltip="Backtest showed Long absorptions produce overwhelming 98% edge on BTC")

grp_risk = "Risk & Targets"
atr_mult = input.float(1.0, "Stop Loss ATR Buffer", step=0.1, group=grp_risk)
rr_tp1   = input.float(1.5, "TP1 Risk-Reward Ratio (60% close)", step=0.1, group=grp_risk)
rr_tp2   = input.float(3.0, "TP2 Risk-Reward Ratio (40% runner)", step=0.5, group=grp_risk)

grp_time = "Session Windows (UTC)"
enable_london = input.bool(true, "Enable London Session (07:00 - 11:00 UTC)", group=grp_time)
enable_ny     = input.bool(true, "Enable NY Session (13:00 - 18:00 UTC)", group=grp_time)

// ==========================================
// TIME WINDOWS
// ==========================================
in_london = not na(time(timeframe.period, "0700-1100", "UTC")) and enable_london
in_ny     = not na(time(timeframe.period, "1300-1800", "UTC")) and enable_ny
is_active_session = in_london or in_ny

// ==========================================
// ORDERFLOW & VOLUME CALCULATIONS
// ==========================================
vol_ma     = ta.sma(volume, 20)
vol_climax = volume >= (vol_ma * vol_mult)

// Local Liquidity Levels
local_high = ta.highest(high, lookback)[1]
local_low  = ta.lowest(low, lookback)[1]

// Candle Range & Wicks
candle_range = math.max(0.5, high - low)
upper_wick   = high - math.max(open, close)
lower_wick   = math.min(open, close) - low

upper_wick_ratio = upper_wick / candle_range
lower_wick_ratio = lower_wick / candle_range

atr = ta.atr(14)

// ==========================================
// ABSORPTION SIGNAL DETECTION
// ==========================================
// Bullish Absorption: Panic sellers swept local low, but limit buyers absorbed the dump (Climax Vol + 30%+ Lower Wick)
bull_absorption = is_active_session and vol_climax and (low <= local_low) and (lower_wick_ratio >= wick_min)

// Bearish Absorption: Breakout buyers swept local high, but limit sellers absorbed the pump (Climax Vol + 30%+ Upper Wick)
bear_absorption = is_active_session and vol_climax and (high >= local_high) and (upper_wick_ratio >= wick_min) and not long_only

// Execution Variables
long_entry = low + 0.50 * lower_wick
long_stop  = low - atr_mult * atr
long_dist  = long_entry - long_stop
long_tp1   = long_entry + rr_tp1 * long_dist
long_tp2   = long_entry + rr_tp2 * long_dist

short_entry = high - 0.50 * upper_wick
short_stop  = high + atr_mult * atr
short_dist  = short_stop - short_entry
short_tp1   = short_entry - rr_tp1 * short_dist
short_tp2   = short_entry - rr_tp2 * short_dist

// ==========================================
// STRATEGY EXECUTION (50% CE Limit Entry, Multi-TP)
// ==========================================
if bull_absorption and long_dist >= 40.0 and strategy.position_size == 0
    strategy.entry("Long_TP1", strategy.long, limit=long_entry, qty=6) // 60% position
    strategy.entry("Long_TP2", strategy.long, limit=long_entry, qty=4) // 40% position
    strategy.exit("Exit_L_TP1", "Long_TP1", stop=long_stop, limit=long_tp1)
    strategy.exit("Exit_L_TP2", "Long_TP2", stop=long_stop, limit=long_tp2)

if bear_absorption and short_dist >= 40.0 and strategy.position_size == 0
    strategy.entry("Short_TP1", strategy.short, limit=short_entry, qty=6)
    strategy.entry("Short_TP2", strategy.short, limit=short_entry, qty=4)
    strategy.exit("Exit_S_TP1", "Short_TP1", stop=short_stop, limit=short_tp1)
    strategy.exit("Exit_S_TP2", "Short_TP2", stop=short_stop, limit=short_tp2)

// Lock Breakeven on runner after TP1 is hit
if strategy.position_size > 0
    if ta.change(strategy.closedtrades) > 0
        last_id = strategy.closedtrades.entry_id(strategy.closedtrades - 1)
        if last_id == "Long_TP1"
            strategy.exit("Exit_L_TP2", "Long_TP2", stop=strategy.position_avg_price + 20.0, limit=long_tp2)

if strategy.position_size < 0
    if ta.change(strategy.closedtrades) > 0
        last_id = strategy.closedtrades.entry_id(strategy.closedtrades - 1)
        if last_id == "Short_TP1"
            strategy.exit("Exit_S_TP2", "Short_TP2", stop=strategy.position_avg_price - 20.0, limit=short_tp2)

// ==========================================
// VISUALS & ON-CHART ORDERFLOW MARKERS
// ==========================================
plot(local_high, "Local Liquidity High", color=color.new(color.red, 60), style=plot.style_stepline)
plot(local_low, "Local Liquidity Low", color=color.new(color.green, 60), style=plot.style_stepline)

// Background color for active London & NY sessions
bgcolor(in_london ? color.new(color.blue, 96) : na, title="London Session")
bgcolor(in_ny ? color.new(color.orange, 96) : na, title="NY Session")

// Signal Markers
plotshape(bull_absorption, "Delta Buy Absorption", shape.triangleup, location.belowbar, color=color.green, size=size.normal, text="ABSORPTION BUY")
plotshape(bear_absorption, "Delta Sell Absorption", shape.triangledown, location.abovebar, color=color.red, size=size.normal, text="ABSORPTION SELL")

// Climax volume bar highlight
barcolor(vol_climax and (bull_absorption or bear_absorption) ? color.yellow : na, title="Absorption Climax Bar")
