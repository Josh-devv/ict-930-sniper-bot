// ==================================================================
// BTC 15m Daily-Leg Precision Indicator
// VP6 + SMC/Pullback + Delta + Daily Open — FINAL-F
// ==================================================================
// This is a SEPARATE indicator from the existing BTC Orderflow Absorption bot.
// Tag: [BTC 15m DAILY LEG]
// ==================================================================

//@version=5
indicator("BTC 15m Daily-Leg Precision", overlay=true, max_bars_back=500, max_labels_count=100)

// ==================== INPUTS ====================
grp_session = "Session"
london_start      = input.int(7,   "London Start Hour (UTC)",    group=grp_session, minval=0, maxval=23)
ny_end            = input.int(18,  "NY End Hour (UTC)",          group=grp_session, minval=0, maxval=23)
weekdays_only     = input.bool(true, "Weekdays Only (Mon-Fri)",  group=grp_session)
max_trades_day    = input.int(2,   "Max Trades Per Day",         group=grp_session, minval=1, maxval=5)

grp_trend = "Trend & Structure"
ema20_len         = input.int(20,  "EMA 20 Length",              group=grp_trend)
ema50_len         = input.int(50,  "EMA 50 Length",              group=grp_trend)
htf_ema_len       = input.int(50,  "HTF EMA Length (1H)",        group=grp_trend)
dist_cap          = input.float(8.0, "Max Distance from HTF EMA (ATR)", group=grp_trend)
min_body_ratio    = input.float(0.45, "Min Body Ratio (Pullback)", group=grp_trend, step=0.05)
smc_lookback      = input.int(18,  "SMC Sweep Lookback Bars",   group=grp_trend, minval=5)

grp_vp = "Volume Profile"
vp_lookback       = input.int(96,  "VP Lookback Bars (24h)",     group=grp_vp)
vp_bins           = input.int(50,  "VP Price Bins",              group=grp_vp)
vp_proximity      = input.float(0.8, "VP Proximity (ATR mult)", group=grp_vp, step=0.1)

grp_of = "Orderflow"
delta_threshold   = input.float(0.1, "Delta Confirm Threshold",  group=grp_of, step=0.05)

grp_exit = "Exit Management"
rr1               = input.float(1.5, "TP1 Risk Multiple",       group=grp_exit, step=0.5)
rr2               = input.float(4.0, "TP2 Risk Multiple",       group=grp_exit, step=0.5)
atr_sl_pad        = input.float(0.4, "SL ATR Padding",          group=grp_exit, step=0.1)

grp_risk = "Risk"
min_risk_pts      = input.float(100.0, "Min Risk (points)",     group=grp_risk)

grp_alert = "Alerts"
show_labels       = input.bool(true, "Show Signal Labels",       group=grp_alert)
show_tp_sl        = input.bool(true, "Show TP/SL Lines",         group=grp_alert)

// ==================== CALCULATIONS ====================
// ATR
atr14 = ta.atr(14)

// EMAs on 15m
ema20 = ta.ema(close, ema20_len)
ema50 = ta.ema(close, ema50_len)

// HTF EMA (1H EMA50 via request.security)
ema50_1h = request.security(syminfo.tickerid, "60", ta.ema(close, htf_ema_len)[1], barmerge.gaps_off, barmerge.lookahead_on)

// Time / Session
hour_utc  = hour(time, "UTC")
dow       = dayofweek(time, "UTC")  // 1=Sun, 7=Sat
is_weekday = dow >= 2 and dow <= 6
in_session = hour_utc >= london_start and hour_utc <= ny_end
pass_time  = (weekdays_only ? is_weekday : true) and in_session

// Daily Open
var float daily_open = na
new_day = ta.change(dayofmonth(time, "UTC")) != 0
if new_day
    daily_open := open

// ==================== VOLUME PROFILE (rolling 24h) ====================
// POC calculation (simplified using arrays)
var float poc_price = na
var float vwap_price = na

// Session VWAP
var float cum_pv = 0.0
var float cum_vol = 0.0
if new_day
    cum_pv  := 0.0
    cum_vol := 0.0
tp_bar   = (high + low + close) / 3.0
cum_pv  += tp_bar * volume
cum_vol += volume
vwap_price := cum_vol > 0 ? cum_pv / cum_vol : close

// POC via bins (rolling lookback)
if bar_index >= vp_lookback
    float p_min = ta.lowest(low, vp_lookback)
    float p_max = ta.highest(high, vp_lookback)
    float p_range = p_max - p_min
    if p_range > 50
        float bin_size = p_range / vp_bins
        // Find the bin with highest volume using a simplified approach
        // We approximate by checking which price level has most typical-price hits
        var float[] bin_vols = array.new_float(vp_bins, 0.0)
        // Reset bins
        for idx = 0 to vp_bins - 1
            array.set(bin_vols, idx, 0.0)
        // Fill bins from lookback bars
        for j = 0 to vp_lookback - 1
            float tp_j = (high[j] + low[j] + close[j]) / 3.0
            int b_idx = math.max(0, math.min(vp_bins - 1, math.floor((tp_j - p_min) / bin_size)))
            float cur = array.get(bin_vols, b_idx)
            array.set(bin_vols, b_idx, cur + volume[j])
        // Find max bin
        int max_bin = 0
        float max_vol_bin = 0.0
        for idx = 0 to vp_bins - 1
            if array.get(bin_vols, idx) > max_vol_bin
                max_vol_bin := array.get(bin_vols, idx)
                max_bin := idx
        poc_price := p_min + (max_bin + 0.5) * bin_size

// VP Filter: price near POC or VWAP
near_poc  = not na(poc_price) and math.abs(close - poc_price) <= vp_proximity * atr14
near_vwap = not na(vwap_price) and math.abs(close - vwap_price) <= vp_proximity * atr14
vp_pass   = near_poc or near_vwap

// ==================== DELTA PROXY ====================
bar_range  = high - low
delta_prox = bar_range > 0 ? (2.0 * (close - low) / bar_range - 1.0) : 0.0

// ==================== SMC SIGNAL ====================
// Distance check
htf_dist_ok = not na(ema50_1h) and atr14 > 0 and math.abs(close - ema50_1h) / atr14 <= dist_cap

// Liquidity Sweep detection
swept_low  = ta.lowest(low, 4) < ta.lowest(low[4], smc_lookback - 4)
swept_high = ta.highest(high, 4) > ta.highest(high[4], smc_lookback - 4)

// MSS / FVG proxy
body = math.abs(close - open)
rng  = math.max(1.0, high - low)

// Bullish SMC: swept lows + (FVG gap up OR MSS break) + close > open + above HTF EMA
bull_smc = swept_low and ((low > high[2]) or (close > ta.highest(high[1], 3))) and close > open and close > ema50_1h
// Bearish SMC: swept highs + (FVG gap down OR MSS break) + close < open + below HTF EMA
bear_smc = swept_high and ((high < low[2]) or (close < ta.lowest(low[1], 3))) and close < open and close < ema50_1h

// Bullish Pullback: uptrend + touched EMA20 + bounced + strong body
bull_pb = close > ema50_1h and ema20 > ema50 and low <= ema20 and close > ema20 and close > open and body / rng >= min_body_ratio and close > high[1]
// Bearish Pullback
bear_pb = close < ema50_1h and ema20 < ema50 and high >= ema20 and close < ema20 and close < open and body / rng >= min_body_ratio and close < low[1]

// Combined signal
bull_sig = htf_dist_ok and (bull_smc or bull_pb)
bear_sig = htf_dist_ok and (bear_smc or bear_pb)

// ==================== ENTRY / EXIT CALC ====================
bull_entry = close
bull_stop  = ta.lowest(low, 4) - atr_sl_pad * atr14
bull_risk  = bull_entry - bull_stop
bull_tp1   = bull_entry + rr1 * bull_risk
bull_tp2   = bull_entry + rr2 * bull_risk

bear_entry = close
bear_stop  = ta.highest(high, 4) + atr_sl_pad * atr14
bear_risk  = bear_stop - bear_entry
bear_tp1   = bear_entry - rr1 * bear_risk
bear_tp2   = bear_entry - rr2 * bear_risk

// ==================== DAILY OPEN FILTER ====================
do_bull = not na(daily_open) and close > daily_open
do_bear = not na(daily_open) and close < daily_open

// ==================== DELTA CONFIRMS DIRECTION ====================
delta_bull = delta_prox >= delta_threshold
delta_bear = delta_prox <= -delta_threshold

// ==================== TRADE COUNTER (max per day) ====================
var int trades_today = 0
if new_day
    trades_today := 0
can_trade = trades_today < max_trades_day

// ==================== FINAL SIGNALS ====================
// All filters: Time + VP6 + Delta + Daily Open + Risk + Trade Cap
buy_signal  = pass_time and bull_sig and vp_pass and delta_bull and do_bull and bull_risk >= min_risk_pts and can_trade
sell_signal = pass_time and bear_sig and vp_pass and delta_bear and do_bear and bear_risk >= min_risk_pts and can_trade

// Cooldown (skip 4 bars after signal)
var int cooldown = 0
cooldown := cooldown > 0 ? cooldown - 1 : 0

final_buy  = buy_signal and cooldown == 0
final_sell = sell_signal and cooldown == 0

if final_buy or final_sell
    cooldown := 4
    trades_today += 1

// ==================== PLOTTING ====================
// EMAs
plot(ema20, "EMA 20", color=color.new(color.orange, 30), linewidth=1)
plot(ema50, "EMA 50", color=color.new(color.blue, 30), linewidth=1)
plot(ema50_1h, "1H EMA 50", color=color.new(color.purple, 40), linewidth=2)

// Daily Open
plot(daily_open, "Daily Open", color=color.new(color.gray, 50), linewidth=1, style=plot.style_stepline)

// POC
plot(poc_price, "POC", color=color.new(color.yellow, 50), linewidth=1, style=plot.style_circles)

// VWAP
plot(vwap_price, "VWAP", color=color.new(color.teal, 50), linewidth=1, style=plot.style_stepline)

// Signal Labels
if final_buy and show_labels
    label.new(bar_index, low, "BUY\n" + str.tostring(close, "#.0"), style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)

if final_sell and show_labels
    label.new(bar_index, high, "SELL\n" + str.tostring(close, "#.0"), style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

// TP/SL lines (last 20 bars)
if final_buy and show_tp_sl
    line.new(bar_index, bull_stop, bar_index + 20, bull_stop, color=color.red, width=1, style=line.style_dashed)
    line.new(bar_index, bull_tp1,  bar_index + 20, bull_tp1,  color=color.orange, width=1, style=line.style_dashed)
    line.new(bar_index, bull_tp2,  bar_index + 20, bull_tp2,  color=color.green, width=1, style=line.style_dashed)

if final_sell and show_tp_sl
    line.new(bar_index, bear_stop, bar_index + 20, bear_stop, color=color.red, width=1, style=line.style_dashed)
    line.new(bar_index, bear_tp1,  bar_index + 20, bear_tp1,  color=color.orange, width=1, style=line.style_dashed)
    line.new(bar_index, bear_tp2,  bar_index + 20, bear_tp2,  color=color.green, width=1, style=line.style_dashed)

// Background for active session
bgcolor(pass_time ? color.new(color.blue, 95) : na)

// ==================== ALERTS ====================
// Use alert() instead of alertcondition() so we can include series values (TP/SL levels)

if final_buy
    alert('{"signal":"BUY","entry":' + str.tostring(close, "#.0") + ',"stop":' + str.tostring(bull_stop, "#.0") + ',"tp1":' + str.tostring(bull_tp1, "#.0") + ',"tp2":' + str.tostring(bull_tp2, "#.0") + ',"risk":' + str.tostring(bull_risk, "#.0") + '}', alert.freq_once_per_bar_close)

if final_sell
    alert('{"signal":"SELL","entry":' + str.tostring(close, "#.0") + ',"stop":' + str.tostring(bear_stop, "#.0") + ',"tp1":' + str.tostring(bear_tp1, "#.0") + ',"tp2":' + str.tostring(bear_tp2, "#.0") + ',"risk":' + str.tostring(bear_risk, "#.0") + '}', alert.freq_once_per_bar_close)
